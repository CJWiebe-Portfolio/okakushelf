rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules,
// or deploy it with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /figures/{figureId} {
      // Anyone can view the gallery.
      allow read: if true;
      // Only a signed-in admin (created manually in the Firebase console) can write.
      allow write: if request.auth != null;
    }
  }
}
